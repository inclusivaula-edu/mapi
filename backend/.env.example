# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...   # chave service_role (só backend)
SUPABASE_ANON_KEY=eyJhbGc...           # chave anon (opcional fallback)

# ── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Servidor ─────────────────────────────────────────────────
PORT=3000
NODE_ENV=development                   # production | development
FRONTEND_URL=http://localhost:3000     # mesmo servidor serve o frontend

# ── Super-admin ───────────────────────────────────────────────
ADMIN_SECRET=troque-por-segredo-forte

# ── Billing / Webhook ─────────────────────────────────────────
# Stripe: obter em dashboard.stripe.com → Webhooks → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
# Mercado Pago (alternativo ao Stripe)
# MERCADOPAGO_WEBHOOK_SECRET=abc123...
