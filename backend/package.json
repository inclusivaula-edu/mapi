{
  "name": "mapi-backend",
  "version": "6.0.0",
  "description": "MAPI — Multi-Agent Platform for Inclusive Education (B2B)",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "harness": "node harness/lessonHarness.js",
    "harness:bail": "node harness/lessonHarness.js --bail",
    "harness:juridico": "node harness/juridicoHarness.js",
    "harness:juridico:bail": "node harness/juridicoHarness.js --bail",
    "harness:all": "npm run harness && npm run harness:juridico"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@supabase/supabase-js": "^2.39.0",
    "dotenv": "^16.3.1",
    "fastify": "^5.8.5",
    "openai": "^6.37.0",
    "pdfkit": "^0.18.0",
    "@fastify/static": "^8.0.0"
  }
}